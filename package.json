{
  "name": "form-events-uptime",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "db:init": "node scripts/init-oracle-table.js",
    "db:init:redes": "node scripts/init-oracle-redes.js",
    "db:init:all": "node scripts/init-oracle-table.js && node scripts/init-oracle-redes.js",
    "db:query": "node scripts/query-oracle.js",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "docker compose up -d --wait oracle",
    "db:stop": "docker compose stop oracle"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "lucide-vue-next": "^0.475.0",
    "oracledb": "^6.7.1",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
