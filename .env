# ==========================================
# CONFIGURACIÓN DE CONEXIÓN A BASE DE DATOS ORACLE
# ==========================================

PORT=3001
ORACLE_USER=SYSTEM
ORACLE_PASSWORD=oracle
ORACLE_CONNECT_STRING=127.0.0.1:1521/XEPDB1
ORACLE_MODE=thin

# Nombre de la tabla de incidentes de sistemas críticos
ORACLE_TABLE_NAME=EVENTOS_DOWNTIME

# Nombre de la tabla de uptime de enlaces de red (WAN, SD-WAN, Agencias, ATMs)
ORACLE_REDES_TABLE_NAME=EVENTOS_REDES
